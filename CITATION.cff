  # --- Core SAR Preprocessing ---
  - type: software
    title: "Sentinel Application Platform (SNAP)"
    abbreviation: "SNAP"
    authors:
      - name: "European Space Agency (ESA)"
    license: "GPL-3.0"
    url: "https://step.esa.int/main/toolboxes/snap/"
    notes: >-
      Used for Sentinel-1 SAR preprocessing: radiometric calibration,
      orbit state vector application, thermal noise removal, and terrain correction.

  # --- Geospatial Libraries ---
  - type: software
    title: "GDAL – Geospatial Data Abstraction Library"
    abbreviation: "GDAL"
    authors:
      - name: "GDAL/OGR contributors"
    license: "MIT"
    url: "https://gdal.org"
    notes: >-
      Used for raster/vector I/O, clipping, reprojection, and BigTIFF creation.

  - type: software
    title: "GeoPandas"
    authors:
