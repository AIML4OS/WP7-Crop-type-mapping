  # --- Satellite Missions & Data Sources ---
  - type: data
    title: "Copernicus Sentinel-1 SAR & Sentinel-2 Optical Data"
    abbreviation: "Sentinel-1 / Sentinel-2"
    authors:
      - name: "European Space Agency (ESA) / European Union Copernicus Programme"
    license: "Copernicus Sentinel Data Terms and Conditions"
    url: "https://dataspace.copernicus.eu"
    notes: >-
      Primary input satellite data obtained via Copernicus Data Space Ecosystem (CDSE)
